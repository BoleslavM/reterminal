# =============================================================================
# reTerminal E1002 – affichage piloté par Home Assistant
#   Vue Maison : météo, agenda, électricité d'hier, Tempo du jour et du lendemain
#   Vue Météo  : tableau illustré + encadré couleur Tempo du lendemain
#   Les deux affichent en petit la date et l'heure du dernier rafraîchissement.
# Bouton vert        : bascule Maison / Météo (automatisation Home Assistant)
# Bouton blanc gauche: redessiner tout de suite
# Redessin automatique à heures fixes : 7h, 9h, 11h, 13h, 15h, 17h et 19h.
# Rien entre 20h et 7h. Le bouton vert redessine tout de suite à toute heure.
# Les dessins sont dans ecran_dessins.h et ecran_ecrans.h (même dossier).
# =============================================================================

esphome:
  name: reterminal-e1002
  friendly_name: reTerminal E1002
  includes:
    - ecran_dessins.h
    - ecran_ecrans.h

esp32:
  board: esp32-s3-devkitc-1
  flash_size: 32MB
  framework:
    type: esp-idf
    advanced:
      enable_idf_experimental_features: true

psram:
  mode: octal

logger:

api:
  encryption:
    key: !secret reterminal_api_key
  # Après un redémarrage : un dessin à jour, sauf la nuit
  on_client_connected:
    - script.execute: redessiner_si_journee

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

# L'attente laisse arriver toutes les valeurs avant de dessiner
script:
  - id: redessiner
    mode: restart
    then:
      - delay: 8s
      - component.update: epaper_display
  - id: redessiner_si_journee
    mode: restart
    then:
      - delay: 8s
      - if:
          condition:
            lambda: |-
              auto t = id(ha_time).now();
              return !t.is_valid() || (t.hour >= 7 && t.hour < 20);
          then:
            - component.update: epaper_display

# Heure de Home Assistant : heure affichée et rafraîchissements à heures fixes
time:
  - platform: homeassistant
    id: ha_time
    on_time:
      - seconds: 0
        minutes: 0
        hours: 7,9,11,13,15,17,19
        then:
          - script.execute: redessiner

# Communication avec l'écran E-Ink
spi:
  clk_pin: GPIO7
  mosi_pin: GPIO9

# -----------------------------------------------------------------------------
# Polices
# -----------------------------------------------------------------------------
font:
  - file: "gfonts://DM Serif Display"
    id: f_titre
    size: 46
    glyphsets: [GF_Latin_Core]
  - file: "gfonts://DM Serif Display"
    id: f_sous_titre
    size: 38
    glyphsets: [GF_Latin_Core]
  - file: "gfonts://Inter@700"
    id: f_chiffres
    size: 96
    glyphs: "0123456789-–,° "
  - file: "gfonts://Inter@500"
    id: f_corps
    size: 24
    glyphsets: [GF_Latin_Core]
  - file: "gfonts://Inter@500"
    id: f_petit
    size: 19
    glyphsets: [GF_Latin_Core]
  - file: "gfonts://Inter@700"
    id: f_gras
    size: 26
    glyphsets: [GF_Latin_Core]
  # Icônes Material Design
  - file: &mdi
      type: web
      url: "https://raw.githubusercontent.com/Templarian/MaterialDesign-Webfont/master/fonts/materialdesignicons-webfont.ttf"
    id: i_grande
    size: 120
    glyphs: &icones
      - "\U000F0599"  # soleil
      - "\U000F0594"  # nuit
      - "\U000F0595"  # éclaircies
      - "\U000F0590"  # nuageux
      - "\U000F0591"  # brouillard
      - "\U000F0596"  # averses
      - "\U000F0597"  # pluie
      - "\U000F0598"  # neige
      - "\U000F0593"  # orage
      - "\U000F11DB"  # fenêtre fermée
      - "\U000F11DC"  # fenêtre ouverte
      - "\U000F0335"  # ampoule
  - file: *mdi
    id: i_petite
    size: 32
    glyphs: *icones

# -----------------------------------------------------------------------------
# Données lues dans Home Assistant
# -----------------------------------------------------------------------------
text_sensor:
  # Vue Maison / Météo : on redessine seulement quand elle change (bouton vert),
  # pas à la première valeur reçue au démarrage
  - platform: homeassistant
    id: t_moment
    entity_id: sensor.ecran_moment
    on_value:
      - if:
          condition:
            lambda: |-
              static std::string avant;
              bool change = !avant.empty() && avant != x;
              avant = x;
              return change;
          then:
            - script.execute: redessiner
  - { platform: homeassistant, id: t_scene, entity_id: sensor.ecran_scene_meteo }
  - { platform: homeassistant, id: t_date, entity_id: sensor.ecran_date }
  - { platform: homeassistant, id: t_meteo, entity_id: sensor.ecran_meteo_texte }
  - { platform: homeassistant, id: t_prev, entity_id: sensor.ecran_previsions }
  - { platform: homeassistant, id: t_ag1, entity_id: sensor.ecran_agenda, attribute: l1 }
  - { platform: homeassistant, id: t_ag2, entity_id: sensor.ecran_agenda, attribute: l2 }
  - { platform: homeassistant, id: t_ag3, entity_id: sensor.ecran_agenda, attribute: l3 }
  - { platform: homeassistant, id: t_ag4, entity_id: sensor.ecran_agenda, attribute: l4 }
  - { platform: homeassistant, id: t_tempo_j, entity_id: sensor.rte_tempo_couleur_actuelle }
  - { platform: homeassistant, id: t_tempo_d, entity_id: sensor.rte_tempo_prochaine_couleur }

sensor:
  - { platform: homeassistant, id: s_temp_ext, entity_id: sensor.ecran_meteo_texte, attribute: temperature }
  - { platform: homeassistant, id: s_tmin, entity_id: sensor.ecran_previsions, attribute: tmin }
  - { platform: homeassistant, id: s_tmax, entity_id: sensor.ecran_previsions, attribute: tmax }
  - { platform: homeassistant, id: s_conso, entity_id: sensor.linky_conso_hier }
  - { platform: homeassistant, id: s_cout, entity_id: sensor.linky_cout_journalier }
  - { platform: homeassistant, id: s_tarif, entity_id: sensor.linky_tarif_actuel }
  - { platform: homeassistant, id: s_lumieres, entity_id: sensor.ecran_maison }
  - { platform: homeassistant, id: s_fenetres, entity_id: sensor.ecran_maison, attribute: fenetres }
  # Pièces : chambre, cuisine, salle à manger, salle de bain, bureau, couloir
  - { platform: homeassistant, id: s_p0, entity_id: sensor.0xa4c138ca65ad0221_temperature }
  - { platform: homeassistant, id: s_p1, entity_id: sensor.0xa4c13875f7e6443d_temperature }
  - { platform: homeassistant, id: s_p2, entity_id: sensor.chauffage_salle_a_manger_local_temperature }
  - { platform: homeassistant, id: s_p3, entity_id: sensor.thermo_salle_de_baing_local_temperature }
  - { platform: homeassistant, id: s_p4, entity_id: sensor.thermo_bureau_local_temperature }
  - { platform: homeassistant, id: s_p5, entity_id: sensor.thermo_couloir_local_temperature }

# -----------------------------------------------------------------------------
# Écran E1002
# -----------------------------------------------------------------------------
display:
  - platform: epaper_spi
    id: epaper_display
    model: Seeed-reTerminal-E1002
    update_interval: never
    lambda: |-
      auto S = [](text_sensor::TextSensor *t) -> std::string {
        if (!t->has_state()) return "";
        std::string s = t->state;
        return (s == "unknown" || s == "unavailable") ? std::string("") : s;
      };
      ecran::Donnees v;
      v.moment = S(id(t_moment));
      if (v.moment.empty()) v.moment = "meteo";
      v.scene = S(id(t_scene));
      if (v.scene.empty()) v.scene = "soleil";
      v.date = S(id(t_date));
      v.meteo = S(id(t_meteo));
      v.prev_cond = S(id(t_prev));
      v.agenda[0] = S(id(t_ag1));
      v.agenda[1] = S(id(t_ag2));
      v.agenda[2] = S(id(t_ag3));
      v.agenda[3] = S(id(t_ag4));
      v.tempo_j = S(id(t_tempo_j));
      v.tempo_d = S(id(t_tempo_d));
      auto maintenant = id(ha_time).now();
      if (maintenant.is_valid()) v.maj = maintenant.strftime("%d/%m %H:%M");
      v.temp_ext = id(s_temp_ext).state;
      v.tmin = id(s_tmin).state;
      v.tmax = id(s_tmax).state;
      v.conso = id(s_conso).state;
      v.cout = id(s_cout).state;
      v.tarif = id(s_tarif).state;
      v.lumieres = std::isnan(id(s_lumieres).state) ? 0 : (int) id(s_lumieres).state;
      v.fenetres = std::isnan(id(s_fenetres).state) ? 0 : (int) id(s_fenetres).state;
      v.t_pieces[0] = id(s_p0).state;
      v.t_pieces[1] = id(s_p1).state;
      v.t_pieces[2] = id(s_p2).state;
      v.t_pieces[3] = id(s_p3).state;
      v.t_pieces[4] = id(s_p4).state;
      v.t_pieces[5] = id(s_p5).state;

      // Adaptateur entre les dessins et l'écran ESPHome
      struct Ecran {
        display::Display &it;
        display::BaseFont *polices[8];
        void draw_pixel_at(int x, int y, Color c) { it.draw_pixel_at(x, y, c); }
        void texte(int x, int y, int p, Color c, int a, const std::string &s) {
          if (s.empty()) return;
          auto al = a == 0 ? display::TextAlign::TOP_LEFT
                  : (a == 1 ? display::TextAlign::TOP_CENTER : display::TextAlign::TOP_RIGHT);
          it.print(x, y, polices[p], c, al, s.c_str());
        }
      };
      // Ordre = enum ecran::Police
      Ecran e{it, {id(f_titre), id(f_sous_titre), id(f_chiffres), id(f_corps), id(f_petit),
                   id(f_gras), id(i_grande), id(i_petite)}};
      ecran::dessiner(e, v);

# -----------------------------------------------------------------------------
# Boutons physiques (les noms gardent les entités existantes)
# -----------------------------------------------------------------------------
binary_sensor:
  - platform: gpio
    name: "Bouton vert"
    pin:
      number: GPIO3
      mode: INPUT_PULLUP
      inverted: true

  - platform: gpio
    name: "Bouton blanc droit"
    pin:
      number: GPIO4
      mode: INPUT_PULLUP
      inverted: true

  - platform: gpio
    name: "Bouton blanc gauche"
    pin:
      number: GPIO5
      mode: INPUT_PULLUP
      inverted: true
    on_press:
      - component.update: epaper_display
